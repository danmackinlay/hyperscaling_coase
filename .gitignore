# Quarto render artifacts
*_cache/
# NB: .tikz-cache/ is deliberately NOT ignored — the pre-rendered diagram SVGs
# are committed so contributors without a TeX install can render the site.
# (`*_cache/` above matches names ending in "_cache", not ".tikz-cache".)
/.quarto/
**/*.quarto_ipynb
.qmd-*/          # old per-doc caches, if any

# Default output dirs
/_site/
/_book/
/docs/
/public/
/output/
/_manuscript/
/_site/
/_book/

# Per-document HTML support dirs
*_files/

# Common document outputs (if rendered next to source)
*.html
*.pdf
*.docx
*.epub

# Jupyter / R artifacts
.ipynb_checkpoints/
.Rproj.user/
.Rhistory
.RData

# OS/editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
*~

.vscode/settings.json

.claude/*.local.*
/.luarc.json

.env